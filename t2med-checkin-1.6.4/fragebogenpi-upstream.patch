+function format_gebdat(string $s): string {
+    $digits = preg_replace('/\D+/', '', $s) ?? '';
+    if (strlen($digits) >= 8) $digits = substr($digits, 0, 8);
+    if (strlen($digits) !== 8) return ($s !== '' ? $s : '—');
+    return substr($digits, 0, 2) . '.' . substr($digits, 2, 2) . '.' . substr($digits, 4, 4);
+}
