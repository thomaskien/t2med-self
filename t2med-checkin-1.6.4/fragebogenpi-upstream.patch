+function parse_float_de(string $s): ?float {
+    $s = trim($s);
+    if ($s === '') return null;
+    $s = str_replace(',', '.', $s);
+    $s = preg_replace('/[^0-9.]/', '', $s) ?? $s;
+    if ($s === '' || $s === '.') return null;
+    return (float)$s;
+}
