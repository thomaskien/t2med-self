-    $lines = array_filter(explode("\n", $raw), fn($l) => trim($l) !== '');
-
-    $fields = [];
-    foreach ($lines as $line) {
-        if (strlen($line) < 7) continue;
-        $rest  = substr($line, 3);
-        $field = substr($rest, 0, 4);
-        $value = substr($rest, 4);
