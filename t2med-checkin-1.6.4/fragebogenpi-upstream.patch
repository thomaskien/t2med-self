-function yaml_ascii_walk($v) {
-    if (is_string($v)) return ascii_only($v);
-    if (is_array($v)) {
-        $out = [];
-        foreach ($v as $k => $vv) {
-            $kk = is_string($k) ? ascii_only($k) : $k;
-            $out[$kk] = yaml_ascii_walk($vv);
-        }
-        return $out;
-    }
-    return $v;
-}
